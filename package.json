{
  "name": "tiny-heist",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tiny Heist - a mobile-first top-down miniature stealth puzzle game. Freeze time. Change the route. Steal it. Escape.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "validate": "tsx tools/validate.ts",
    "validate:verbose": "tsx tools/validate.ts --verbose",
    "cap:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
